# ============ Copier ce fichier en .env et le compléter ============

# --- Agent IA (obligatoire) : clé API depuis https://platform.claude.com ---
ANTHROPIC_API_KEY=sk-ant-...
# Modèle et niveau de réflexion (low | medium | high | xhigh | max)
AGENT_MODELE=claude-opus-5-5
AGENT_EFFORT=medium
# true = l'agent envoie les e-mails sans validation humaine (déconseillé au démarrage)
AGENT_ENVOI_AUTO=false

# --- Sécurité ---
# Mot de passe de l'interface (identifiant : n'importe lequel)
ADMIN_PASSWORD=changez-moi
# Jeton du webhook des e-mails entrants (chaîne longue et aléatoire)
WEBHOOK_TOKEN=

# --- Routine quotidienne (jours ouvrés) ---
ROUTINE_ACTIVE=true
ROUTINE_HEURE=8
JOURS_RELANCE_DEVIS=7
JOURS_ENTRE_RELANCES=7

# --- Société (apparaît sur devis / factures) ---
SOCIETE_NOM=FRE2G
SOCIETE_FORME=SAS
SOCIETE_ACTIVITE=
SOCIETE_ADRESSE=
SOCIETE_CP=
SOCIETE_VILLE=
SOCIETE_SIRET=
SOCIETE_TVA=
SOCIETE_RCS=
SOCIETE_CAPITAL=
SOCIETE_TEL=
SOCIETE_EMAIL=
SOCIETE_SITE=
SOCIETE_IBAN=
SOCIETE_BIC=
SIGNATURE_EMAIL=Le service ADV FRE2G
# CONDITIONS_VENTE=Pénalités de retard : ...

# --- Envoi des e-mails (SMTP). Sans SMTP : mode simulation ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=adv@votre-domaine.fr
# Copie cachée de chaque e-mail envoyé (archivage)
SMTP_COPIE=

PORT=3000
# DB_PATH=./data/adv.db
