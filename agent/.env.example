# Copiez ce fichier en « .env » et complétez-le.

# --- Accès -------------------------------------------------------------------
# Mot de passe de l'interface d'administration (obligatoire)
ADMIN_PASSWORD=
# Secret des sessions : une longue chaîne aléatoire (sinon les sessions sont perdues à chaque redémarrage)
SESSION_SECRET=

# --- Serveur -----------------------------------------------------------------
PORT=3000
# Adresse publique de l'agent : c'est elle qui figure dans les liens de signature envoyés aux clients.
# En production, une adresse en https (ex. https://devis.fre2g.fr)
BASE_URL=http://localhost:3000
# Derrière un reverse proxy (Nginx, Caddy, Render…), mettez 1 pour enregistrer la vraie IP du signataire
#TRUST_PROXY=1
DATA_DIR=data

# --- E-mails -----------------------------------------------------------------
# Sans SMTP_HOST, les e-mails ne partent pas : ils sont écrits dans data/outbox (mode essai).
# Exemples : OVH ssl0.ovh.net:465 (SMTP_SECURE=true) · Gmail/Google Workspace smtp.gmail.com:465 avec un mot de passe d'application
#            Microsoft 365 smtp.office365.com:587 · iCloud smtp.mail.me.com:587
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=FRE2G <contact@fre2g.fr>
# Adresse FRE2G prévenue à chaque devis signé
MAIL_NOTIFY=
# Copie cachée de tous les e-mails envoyés aux clients et fournisseurs (archive)
MAIL_BCC=

# --- Claude (rédaction des devis à partir des notes de visite) ---------------
# Clé à créer sur https://console.anthropic.com — facultatif : sans clé, l'agent fonctionne sans rédaction automatique
ANTHROPIC_API_KEY=
#ANTHROPIC_MODEL=claude-opus-5-5

# --- PDF ---------------------------------------------------------------------
# Chemin d'un Chromium déjà installé (facultatif ; sinon « npm run install-browser »)
#CHROMIUM_PATH=
